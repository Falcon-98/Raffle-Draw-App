# ─────────────────────────────────────────────────────────────────────────────
# Raffle settings. Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
# `.env` is ignored by git, so passwords in it stay on your computer.
# On GitHub Pages, set the NEXT_PUBLIC_* values as repository *variables* instead
# (Settings → Secrets and variables → Actions → Variables); see the README.
# ─────────────────────────────────────────────────────────────────────────────

# ── Website (read when building: npm run build / npm run dev) ────────────────

# Admin PIN. On GitHub use the ADMIN_PIN repository *secret*. Default: click2026
NEXT_PUBLIC_ADMIN_PIN=

# Default address of the live server, pre-filled in Admin → Online live view.
# Leave empty to use the built-in default: https://raffle-live.inbox-ashen.workers.dev
# (the Cloudflare Worker, set in lib/config.ts). It can always be changed in the admin.
NEXT_PUBLIC_LIVE_SERVER_URL=

# ── Live server (read by: npm run live) ──────────────────────────────────────

# Port for the live server.
PORT=8787

# JSON file where live rooms are stored (created automatically).
LIVE_DATA_FILE=data/live.json

# Optional password needed to start a live view (Admin → Online live view → Server password).
# Recommended when the server is reachable from the internet.
LIVE_CREATE_TOKEN=

# Optional: only allow these sites to use the server (comma-separated), e.g.
# ALLOWED_ORIGINS=https://falcon-98.github.io,http://localhost:3000
ALLOWED_ORIGINS=

# Folder with the built site to serve from the live server too (default: ./out).
STATIC_DIR=out

# ── Later: database instead of the JSON file ─────────────────────────────────
# The live view currently stores rooms in LIVE_DATA_FILE. To move to a hosted
# database (e.g. Supabase) later, only server/live-server.mjs needs to change —
# the website talks to the same small API. Keep the connection details here:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
